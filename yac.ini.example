# Optional starter settings. YAC creates yac.ini on first run.
# Leave language and callsign blank to receive the startup prompts.
[yac]
lang=
call=
# Choose the region for the radio's location with Settings, r. Repeat r to cycle.
region=1
debug=0
step_ssb=1000
step_cw=500
step_am=2500
step_fm=12500

# Optional signed FM repeater offsets in hertz. Blank prompts; choose local values.
repeater_offset_10m_hz=
repeater_offset_6m_hz=
repeater_offset_2m_hz=
repeater_offset_70cm_hz=
repeater_offset_23cm_hz=

# Optional CW audio decoder. Select a radio input explicitly; no default microphone.
# Install requirements-decoders.txt first. Numeric device index or unique device name.
cw_audio_device=
cw_audio_channel=1
cw_audio_pitch_hz=600
cw_audio_threshold=0.01
cw_audio_wpm=20
# Optional verified IC-705 companion USB B port, only needed if identification fails.
rtty_port=
